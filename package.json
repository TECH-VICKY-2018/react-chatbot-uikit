{
  "name": "react-chatbot-uikit",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "A highly customizable, developer-first chatbot UI as a reusable React NPM package.",
  "keywords": [
    "react",
    "chat",
    "chatbot",
    "ui",
    "kit",
    "component",
    "customizable",
    "npm-package"
  ],
  "author": {
    "name": "Pon Vignesh G",
    "email": "ponvignesh.g@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky",
    "typecheck": "tsc -b",
    "build:package": "tsc -b && vite build"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/react-chatbot-uikit.umd.js",
  "module": "./dist/react-chatbot-uikit.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-chatbot-uikit.es.js",
      "require": "./dist/react-chatbot-uikit.umd.js"
    }
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.2.0"
  },
  "peerDependencies": {
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.300.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-icons": "^5.0.0",
    "react-markdown": "^9.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.0.0 || ^4.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.14.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "framer-motion": "^12.11.4",
    "globals": "^16.0.0",
    "husky": "^9.0.11",
    "lucide-react": "^0.510.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.2.8",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "uuid": "^11.1.0",
    "vite": "^6.3.1"
  }
}
